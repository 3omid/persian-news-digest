{
  "name": "news-digest-desktop",
  "productName": "News Digest",
  "version": "1.0.0",
  "description": "خلاصه اخبار - نسخه ویندوز",
  "author": "Omid Farhadnia",
  "license": "MIT",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.omid.newsdigest",
    "productName": "News Digest",
    "files": ["main.cjs", "offline.html", "icon.png"],
    "win": {
      "target": ["nsis", "portable"],
      "signAndEditExecutable": false,
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "خلاصه اخبار",
      "artifactName": "NewsDigest-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NewsDigest-Portable-${version}.${ext}"
    },
    "directories": {
      "output": "release"
    }
  }
}
